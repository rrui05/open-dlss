#version 460
// The renderer's velocity buffer (rgba32ui: object id, depth bits, motion x/y bits with motion = previous NDC -
// current NDC, y up) -> the NR's motion texture (rg16f: current -> previous in uv units of the render target, y
// down as texture rows are; zero where the surface was off screen in the previous frame, and where nothing was
// drawn).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform usampler2D velocity;
layout(set = 0, binding = 1, rg16f) uniform writeonly image2D motion;
layout(push_constant) uniform Push { uint width; uint height; } push;

void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= push.width || id.y >= push.height) return;
    uvec4 v = texelFetch(velocity, ivec2(id), 0);
    vec2 m = vec2(uintBitsToFloat(v.z), uintBitsToFloat(v.w));
    // the current NDC of the pixel center (y up: row 0 is the top of the image)
    vec2 ndc = vec2((float(id.x) + 0.5) / float(push.width) * 2.0 - 1.0, 1.0 - (float(id.y) + 0.5) / float(push.height) * 2.0);
    vec2 prev = ndc + m;
    bool drawn = v.x != 0u || v.y != 0u;   // the clear is zero; a drawn surface has an object id or a non-zero depth
    bool onScreen = all(lessThan(abs(prev), vec2(1.0)));
    vec2 uvMotion = (drawn && onScreen) ? 0.5 * vec2(m.x, -m.y) : vec2(0.0);
    imageStore(motion, ivec2(id), vec4(uvMotion, 0.0, 0.0));
}
